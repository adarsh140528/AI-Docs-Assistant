# -------------------------------------------------------------
# AI Documentation Assistant - Environment Configuration
# -------------------------------------------------------------

# Groq API Key (Get your free key at: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Embedding Engine Mode:
# Set to "local" (default) for 100% offline local SentenceTransformers (on your PC)
# Set to "gemini" for low-RAM cloud deployment on Render Free / Vercel (uses ~35MB RAM)
EMBEDDING_PROVIDER=local
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Configuration
GROQ_MODEL=llama-3.3-70b-versatile

# RAG & Chunking Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5

# Server Port
PORT=8000

